# Application
PORT=3000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=medvita_user
DB_PASSWORD=change-me
DB_NAME=medvita

# TLS obrigatório. Caminho absoluto ou relativo à raiz de api/, também após build.
# Disponibilize o certificado CA neste caminho no ambiente de deploy.
DB_SSL_CA_PATH=certificates/prod-ca-2021.crt

# JWT (use independent, cryptographically random secrets in production)
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_TOKEN_AUDIENCE=http://localhost:3000
JWT_TOKEN_ISSUER=http://localhost:3000
JWT_ACCESS_EXPIRES_IN_SECONDS=900
JWT_REFRESH_EXPIRES_IN_SECONDS=604800

# Se definida, tem precedência sobre DB_*; codifique caracteres especiais da senha.
# TLS é controlado pelo objeto ssl compartilhado; parâmetros ssl* da URL são removidos em memória.
# DATABASE_URL=postgresql://medvita_user:change-me@localhost:5432/medvita

# Bootstrap administrativo manual. Nunca preencha credenciais reais neste exemplo.
SYSTEM_ADMIN_NAME=
SYSTEM_ADMIN_EMAIL=
SYSTEM_ADMIN_PASSWORD=
# Somente na inicialização autorizada em produção: bootstrap-first-system-admin.
# Manter desativado na configuração permanente do deploy.
SYSTEM_ADMIN_ALLOW_PRODUCTION=
